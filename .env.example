# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# NOTE: These are PUBLIC keys used in the browser. Never commit actual values to Git.
# Always use .env.local for local development (excluded by .gitignore)
# For production, set environment variables in Vercel dashboard
